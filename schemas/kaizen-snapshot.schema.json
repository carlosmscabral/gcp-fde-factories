{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/kaizen-snapshot.schema.json",
  "title": "Kaizen 0-Token Telemetry Snapshot (v0.3.0)",
  "description": "Validates the deterministic telemetry snapshot generated by core-gcp-fde/scripts/kaizen_collect.py.",
  "type": "object",
  "required": [
    "schema_version",
    "collected_at_utc",
    "sources_status",
    "hub_metrics",
    "control_plane",
    "github_ci",
    "scratchpad",
    "repo_drift",
    "source_errors"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "collected_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "hub_project_id": { "type": ["string", "null"], "maxLength": 128 },
    "time_zone": { "type": "string", "maxLength": 64 },
    "sources_status": {
      "type": "object",
      "required": [
        "hub_metrics",
        "scion_control_plane",
        "github_ci",
        "scratchpad",
        "repo_drift",
        "gcp_observability"
      ],
      "additionalProperties": false,
      "properties": {
        "hub_metrics": { "type": "string", "enum": ["ok", "skipped", "error"] },
        "scion_control_plane": { "type": "string", "enum": ["ok", "skipped", "error"] },
        "github_ci": { "type": "string", "enum": ["ok", "skipped", "error"] },
        "scratchpad": { "type": "string", "enum": ["ok", "skipped", "error"] },
        "repo_drift": { "type": "string", "enum": ["ok", "skipped", "error"] },
        "gcp_observability": { "type": "string", "enum": ["ok", "skipped", "error"] }
      }
    },
    "hub_metrics": {
      "type": "object",
      "required": ["project_summary", "agents", "tool_error_rates"],
      "additionalProperties": false,
      "properties": {
        "project_summary": { "type": ["object", "null"] },
        "agents": { "type": "array", "items": { "type": "object" } },
        "tool_error_rates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "calls", "errors", "error_rate"],
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string", "maxLength": 80 },
              "calls": { "type": "integer", "minimum": 0 },
              "errors": { "type": "integer", "minimum": 0 },
              "error_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "window_note": { "type": "string", "maxLength": 160 }
      }
    },
    "control_plane": {
      "type": "object",
      "required": [
        "agent_count",
        "stalled_agents",
        "limits_exceeded_agents",
        "artifacts_count",
        "decisions_count"
      ],
      "additionalProperties": false,
      "properties": {
        "agent_count": { "type": "integer", "minimum": 0 },
        "stalled_agents": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
        "limits_exceeded_agents": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
        "artifacts_count": { "type": ["integer", "null"], "minimum": 0 },
        "decisions_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "github_ci": {
      "type": "object",
      "required": [
        "merged_prs",
        "avg_review_rounds",
        "avg_lead_time_hours",
        "failed_ci_runs",
        "hygiene_issues_open"
      ],
      "additionalProperties": false,
      "properties": {
        "merged_prs": { "type": "integer", "minimum": 0 },
        "avg_review_rounds": { "type": ["number", "null"], "minimum": 0.0 },
        "avg_lead_time_hours": { "type": ["number", "null"], "minimum": 0.0 },
        "failed_ci_runs": { "type": "integer", "minimum": 0 },
        "hygiene_issues_open": { "type": "integer", "minimum": 0 }
      }
    },
    "scratchpad": {
      "type": "object",
      "required": [
        "verdict_counts",
        "sandbox_ledger_entries",
        "kaizen_events_count",
        "workarounds_expiring_soon",
        "backlog_open_count"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "live-gcp-verified": { "type": "integer", "minimum": 0 },
            "not-verifiable-in-sandbox": { "type": "integer", "minimum": 0 },
            "unit-test-verified": { "type": "integer", "minimum": 0 },
            "static-check-only": { "type": "integer", "minimum": 0 },
            "verifier-blocked": { "type": "integer", "minimum": 0 },
            "verifier-failed": { "type": "integer", "minimum": 0 },
            "invalid": { "type": "integer", "minimum": 0 }
          }
        },
        "sandbox_ledger_entries": { "type": "integer", "minimum": 0 },
        "kaizen_events_count": { "type": "integer", "minimum": 0 },
        "backlog_open_count": { "type": "integer", "minimum": 0 },
        "workarounds_expiring_soon": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "component", "days_remaining"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "maxLength": 40 },
              "component": { "type": "string", "maxLength": 64 },
              "days_remaining": { "type": "integer" }
            }
          }
        }
      }
    },
    "repo_drift": {
      "type": "object",
      "required": ["drift_detected", "missing_binaries", "notes"],
      "additionalProperties": false,
      "properties": {
        "drift_detected": { "type": "boolean" },
        "missing_binaries": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "notes": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
      }
    },
    "gcp_observability": { "type": ["object", "null"] },
    "proposal_verifications": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["proposal_id", "status", "prs_observed", "window_required", "measured_value", "revert_command", "reason"],
        "additionalProperties": false,
        "properties": {
          "proposal_id": { "type": "string", "maxLength": 48 },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "implemented",
              "measuring",
              "verified_pass",
              "rollback_triggered",
              "invalidated_regression",
              "rejected"
            ]
          },
          "implemented_pr_number": { "type": ["integer", "null"] },
          "prs_observed": { "type": "integer", "minimum": 0 },
          "window_required": { "type": "integer", "minimum": 1 },
          "measured_value": { "type": ["number", "null"] },
          "revert_command": { "type": ["string", "null"], "maxLength": 160 },
          "reason": { "type": "string", "maxLength": 240 }
        }
      }
    },
    "source_errors": { "type": "array", "items": { "type": "string", "maxLength": 240 } }
  }
}
