{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/verdict.schema.json",
  "title": "Verifiable Factory Verdict (Contract 5)",
  "description": "Anti-forgery PR verdict record checked against live GCP Sandbox APIs (CES, Vertex AI Agent Engine, or Gemini Enterprise) in CI.",
  "type": "object",
  "required": [
    "schema_version",
    "pr_number",
    "commit_sha",
    "diversity_profile",
    "evals_tree_sha256",
    "gates_executed",
    "gates_skipped",
    "verdict",
    "created_at_utc"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "pack": { "type": "string", "enum": ["gecx", "adk", "agent-platform"] },
    "pr_number": { "type": "integer", "minimum": 1 },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "diversity_profile": { "type": "string", "enum": ["cross-vendor", "cross-model", "single-family"] },
    "ephemeral_app_name": {
      "type": ["string", "null"],
      "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/(apps|reasoningEngines)/[A-Za-z0-9-]+$"
    },
    "ge_agent_resource": {
      "type": ["string", "null"],
      "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/collections/default_collection/engines/[A-Za-z0-9_-]+/assistants/[A-Za-z0-9_-]+/agents/[A-Za-z0-9_-]+$"
    },
    "evaluation_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/apps/[A-Za-z0-9-]+/evaluationRuns/[A-Za-z0-9-]+$"
      },
      "default": []
    },
    "expected_evaluator_sa": { "type": ["string", "null"] },
    "evals_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gates_executed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates_skipped": {
      "type": "array",
      "items": { "type": "string" }
    },
    "not_verifiable_surfaces": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "verdict": {
      "type": "string",
      "enum": [
        "live-gcp-verified",
        "not-verifiable-in-sandbox",
        "unit-test-verified",
        "static-check-only",
        "verifier-blocked",
        "verifier-failed"
      ]
    },
    "created_at_utc": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "live-gcp-verified" } } },
      "then": {
        "required": ["expected_evaluator_sa"],
        "anyOf": [
          {
            "required": ["ephemeral_app_name", "evaluation_run_ids"],
            "properties": {
              "ephemeral_app_name": { "type": "string", "pattern": "/apps/" },
              "evaluation_run_ids": { "type": "array", "minItems": 1 }
            }
          },
          {
            "required": ["ephemeral_app_name"],
            "properties": {
              "ephemeral_app_name": { "type": "string", "pattern": "/reasoningEngines/" }
            }
          },
          {
            "required": ["ge_agent_resource"],
            "properties": {
              "ge_agent_resource": { "type": "string" }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "not-verifiable-in-sandbox" } } },
      "then": {
        "required": ["not_verifiable_surfaces"],
        "properties": {
          "not_verifiable_surfaces": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
