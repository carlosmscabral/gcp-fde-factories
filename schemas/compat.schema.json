{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/compat.schema.json",
  "title": "Compatibility Matrix Schema",
  "description": "Enforces a closed list of tested Scion releases and exact 40-char upstream commits.",
  "type": "object",
  "required": ["schema_version", "pack", "pack_version", "scion", "agent_team", "toolchain", "images", "models", "canary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "pack": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "scion": {
      "type": "object",
      "required": ["tested", "binary_url", "binary_sha256", "downgrade_floor", "experiments_required"],
      "additionalProperties": false,
      "properties": {
        "tested": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.]+)?$" }
        },
        "binary_url": { "type": "string", "pattern": "^https://" },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "downgrade_floor": { "type": "string", "minLength": 1 },
        "experiments_required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agent_team": {
      "type": "object",
      "required": ["repository", "commit", "license", "skills_lock"],
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license": { "type": "string", "enum": ["MIT", "Apache-2.0"] },
        "skills_lock": { "type": "string" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pip_version", "repository", "skill_commit", "license"],
        "properties": {
          "pip_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "repository": { "type": "string" },
          "skill_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "license": { "type": "string", "enum": ["MIT", "Apache-2.0"] }
        }
      }
    },
    "images": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "@sha256:[0-9a-f]{64}$"
      }
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 3 }
    },
    "canary": {
      "type": "object",
      "required": ["run_id", "date_brt"],
      "properties": {
        "run_id": { "type": "string", "minLength": 3 },
        "date_brt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notes": { "type": "string" }
      }
    }
  }
}
