{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/hub-project.schema.json",
  "title": "Hub Project Declarative Overlay (Contract 2 v2)",
  "description": "Declares customer overlay settings reconciled by deploy/03-hub-bootstrap/bootstrap-hub-project.sh. Retrocompatible with v0.2.0.",
  "type": "object",
  "required": [
    "schema_version",
    "pack",
    "pack_version",
    "mode",
    "diversity_profile",
    "limits",
    "overlay_skills"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "pack": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mode": { "type": "string", "enum": ["sandbox-direct", "ci-only"] },
    "diversity_profile": { "type": "string", "enum": ["cross-vendor", "cross-model", "single-family"] },
    "limits": {
      "type": "object",
      "required": ["default_max_duration", "default_max_turns", "auto_suspend_idle"],
      "additionalProperties": false,
      "properties": {
        "default_max_duration": { "type": "string", "pattern": "^[0-9]+(m|h)$" },
        "default_max_turns": { "type": "integer", "minimum": 10, "maximum": 200 },
        "default_max_model_calls": { "type": "integer", "minimum": 10, "maximum": 500 },
        "auto_suspend_idle": { "type": "boolean" }
      }
    },
    "exclude_skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "default": []
    },
    "overlay_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dir", "version"],
        "additionalProperties": false,
        "properties": {
          "dir": { "type": "string", "pattern": "^skills/[a-z0-9-]+$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
        }
      }
    },
    "kaizen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "schedule_cron": { "type": "string" },
        "time_zone": { "type": "string", "default": "America/Sao_Paulo" },
        "coordinator_agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "default": "coordinator" },
        "enable_gcp_obs": { "type": "boolean", "default": false }
      }
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "enum": ["antigravity-vertex", "claude-vertex"], "default": "antigravity-vertex" },
        "claude_model_garden_enabled": { "type": "boolean", "default": false },
        "vertex_gemini_location": { "type": "string", "pattern": "^[a-z0-9-]+$", "default": "global" },
        "vertex_claude_region": { "type": "string", "pattern": "^[a-z0-9-]+$", "default": "global" }
      }
    },
    "model_routing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["harness", "model"],
        "additionalProperties": false,
        "properties": {
          "harness": { "type": "string", "enum": ["antigravity-vertex", "claude-vertex"] },
          "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "thinking_level": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "brownfield": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track": { "type": "string", "enum": ["express", "complete"] },
        "existing_hub": { "type": "boolean", "default": false },
        "custom_image_dockerfile": { "type": ["string", "null"] },
        "tester_image_dockerfile": { "type": ["string", "null"] },
        "profile_path": { "type": "string", "default": ".factory/factory-profile.yaml" }
      }
    },
    "deploy_target": {
      "type": "string",
      "enum": ["cloud-run", "gke", "agent-engine", "ces", "custom", "none"]
    },
    "monorepo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "subdir": { "type": "string", "pattern": "^[^\\r\\n`]{0,160}$", "default": "" },
        "agent_prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" }
      }
    },
    "roster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled_roles": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "disabled_roles": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "max_wip": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
        "reviewer_replicas": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "provider": { "type": "string", "enum": ["github", "azure_devops", "gitlab", "jira"], "default": "github" },
        "max_concurrent_issues": { "type": "integer", "minimum": 1, "maximum": 3, "default": 2 },
        "scope_label": { "type": "string", "maxLength": 64, "default": "" },
        "release_label": { "type": "string", "minLength": 1, "maxLength": 64, "default": "factory:ready" },
        "hold_label": { "type": "string", "minLength": 1, "maxLength": 64, "default": "factory:hold" },
        "cadence_cron": { "type": "string", "minLength": 5, "maxLength": 64, "default": "*/5 * * * *" },
        "time_zone": { "type": "string", "minLength": 1, "maxLength": 64, "default": "America/Sao_Paulo" },
        "paused": { "type": "boolean", "default": false }
      }
    }
  }
}
