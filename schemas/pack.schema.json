{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/pack.schema.json",
  "title": "Factory Pack Manifest (Contract 1)",
  "description": "Validates pack.yaml declarations and maps each section to deterministic Scion objects.",
  "type": "object",
  "required": [
    "schema_version",
    "pack",
    "upstream",
    "specialist_templates",
    "project_skills",
    "runtime_image",
    "context_budget",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "pack": {
      "type": "object",
      "required": ["name", "prefix", "version", "status", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,15}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "type": "string", "enum": ["pilot", "active", "skeleton", "deprecated"] },
        "description": { "type": "string", "minLength": 10 }
      }
    },
    "upstream": {
      "type": "object",
      "required": ["agent_team_repo", "agent_team_commit", "skills_lock"],
      "additionalProperties": false,
      "properties": {
        "agent_team_repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "agent_team_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "skills_lock": { "type": "string", "minLength": 1 }
      }
    },
    "specialist_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "base_role", "hub_role", "sandbox_sa_slot"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "base_role": {
            "type": "string",
            "enum": [
              "architect", "code-reviewer", "coordinator", "developer",
              "doc-writer", "eng-manager", "investigator", "qa-tester",
              "release-notes", "researcher", "security-auditor",
              "test-engineer", "web-builder"
            ]
          },
          "delta_dir": { "type": "string", "minLength": 1 },
          "hub_role": { "type": "string", "enum": ["baseline", "full"] },
          "sandbox_sa_slot": { "type": "string", "enum": ["worker", "deployer", "evaluator", "none"] },
          "role_skills": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "strip_hardcoded_model": { "type": "boolean", "default": true }
        }
      }
    },
    "project_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "local_dir", "version", "scope"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "local_dir": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "scope": { "type": "string", "enum": ["global", "project"] },
          "attach_to_project": { "type": "boolean", "default": true }
        }
      }
    },
    "vendored_image_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "target_path", "upstream_repo", "commit", "license"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "target_path": { "type": "string", "pattern": "^/opt/[a-z0-9/_-]+$" },
          "upstream_repo": { "type": "string" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "license": { "type": "string", "enum": ["MIT", "Apache-2.0"] }
        }
      }
    },
    "runtime_image": {
      "type": "object",
      "required": ["dockerfile", "harness_configs"],
      "additionalProperties": false,
      "properties": {
        "dockerfile": { "type": "string", "minLength": 1 },
        "harness_configs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "context_budget": {
      "type": "object",
      "required": ["max_total_lines_per_role", "max_lines_per_pack_skill", "max_delta_rules"],
      "additionalProperties": false,
      "properties": {
        "max_total_lines_per_role": { "type": "integer", "minimum": 200, "maximum": 3000 },
        "max_lines_per_pack_skill": { "type": "integer", "minimum": 50, "maximum": 300 },
        "max_delta_rules": { "type": "integer", "minimum": 1, "maximum": 15 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["level1_offline_commands", "level2_sandbox_runner", "not_verifiable_in_sandbox"],
      "additionalProperties": false,
      "properties": {
        "level1_offline_commands": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "level2_sandbox_runner": { "type": "string", "minLength": 1 },
        "not_verifiable_in_sandbox": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
