{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/factory-profile.schema.json",
  "title": "Brownfield Onboarding Factory Profile (v0.4.0)",
  "description": "Validates PO-confirmed onboarding intent and static scanner facts before emitting Layer 3 overlays.",
  "type": "object",
  "required": [
    "schema_version",
    "slug",
    "pack",
    "pack_version",
    "track",
    "existing_hub",
    "mode",
    "diversity_profile",
    "autonomy",
    "git_flow",
    "commands",
    "detected_binaries",
    "missing_binaries",
    "knowledge_sources",
    "modernization_gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,32}$" },
    "pack": { "type": "string", "enum": ["gecx", "adk", "agent-platform"] },
    "pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "track": { "type": "string", "enum": ["express", "complete"] },
    "existing_hub": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["sandbox-direct", "ci-only"] },
    "diversity_profile": { "type": "string", "enum": ["cross-vendor", "cross-model", "single-family"] },
    "autonomy": { "type": "string", "enum": ["supervised", "standard"] },
    "mission": { "type": "string" },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "git_flow": {
      "type": "object",
      "required": ["base_branch", "branch_pattern", "commit_convention", "ci_platform"],
      "additionalProperties": false,
      "properties": {
        "base_branch": { "type": "string", "minLength": 1 },
        "branch_pattern": { "type": "string", "minLength": 1 },
        "commit_convention": { "type": "string", "minLength": 1 },
        "ci_platform": { "type": "string", "enum": ["github-actions", "azure-devops", "gitlab-ci", "none"] },
        "pr_template": { "type": ["string", "null"] }
      }
    },
    "commands": {
      "type": "object",
      "required": ["lint", "test"],
      "additionalProperties": false,
      "properties": {
        "build": { "type": "string" },
        "lint": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "e2e": { "type": "string" }
      }
    },
    "detected_binaries": { "type": "array", "items": { "type": "string" } },
    "missing_binaries": { "type": "array", "items": { "type": "string" } },
    "heavy_test_binaries": { "type": "array", "items": { "type": "string" }, "default": [] },
    "ai_files_detected": { "type": "array", "items": { "type": "string" }, "default": [] },
    "knowledge_sources": { "type": "array", "items": { "type": "string" } },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary", "acceptance_criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
          "summary": { "type": "string", "minLength": 5 },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
        }
      },
      "default": []
    },
    "invariants": { "type": "array", "items": { "type": "string", "minLength": 5 }, "default": [] },
    "evaluation_pyramid": { "type": "object", "default": {} },
    "modernization_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "benefit"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "benefit": { "type": "string" }
        }
      }
    },
    "kaizen_schedule_cron": { "type": "string", "default": "0 17 * * 5" },
    "kaizen_time_zone": { "type": "string", "default": "America/Sao_Paulo" }
  }
}
