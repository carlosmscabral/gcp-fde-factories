{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcp-fde-factories.local/schemas/ge-export.schema.json",
  "title": "Gemini Enterprise (GE App) Agent Export Manifest",
  "description": "Validates ADK Vertex AI Agent Engine and A2A v0.3.0 agent registration manifests against Discovery Engine v1alpha.",
  "type": "object",
  "required": [
    "schema_version",
    "export_mode",
    "display_name",
    "description",
    "gemini_enterprise"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "export_mode": { "type": "string", "enum": ["agent_engine", "a2a"] },
    "display_name": { "type": "string", "minLength": 2, "maxLength": 120 },
    "description": { "type": "string", "minLength": 5, "maxLength": 500 },
    "icon_uri": { "type": "string", "pattern": "^https://" },
    "gemini_enterprise": {
      "type": "object",
      "required": ["project_id", "location", "app_id"],
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{4,30}$" },
        "location": { "type": "string", "enum": ["global", "us", "eu"] },
        "endpoint_location": { "type": "string", "enum": ["global", "us", "eu"] },
        "app_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{2,80}$" },
        "assistant_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$", "default": "default_assistant" }
      }
    },
    "agent_engine": {
      "type": "object",
      "required": ["reasoning_engine_resource"],
      "additionalProperties": false,
      "properties": {
        "reasoning_engine_resource": {
          "type": "string",
          "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/reasoningEngines/[A-Za-z0-9-]+$"
        }
      }
    },
    "a2a": {
      "type": "object",
      "required": ["url", "protocol_version", "version", "default_input_modes", "default_output_modes", "skills"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "streaming": { "type": "boolean", "default": true },
        "preferred_transport": { "type": "string", "minLength": 1 },
        "icon_url": { "type": "string", "pattern": "^https://" },
        "provider": {
          "type": "object",
          "required": ["organization", "url"],
          "additionalProperties": false,
          "properties": {
            "organization": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" }
          }
        },
        "security_schemes": { "type": "object" },
        "security": { "type": "array", "items": { "type": "object" } },
        "default_input_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "default_output_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "tags"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "tags": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "examples": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "inputModes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "outputModes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "tool_authorizations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/authorizations/[A-Za-z0-9_-]+$"
      },
      "default": []
    },
    "agent_authorization": {
      "type": "string",
      "pattern": "^projects/[a-z0-9-]+/locations/[a-z0-9-]+/authorizations/[A-Za-z0-9_-]+$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "export_mode": { "const": "agent_engine" } } },
      "then": {
        "required": ["agent_engine"],
        "not": { "required": ["agent_authorization"] }
      }
    },
    {
      "if": { "properties": { "export_mode": { "const": "a2a" } } },
      "then": {
        "required": ["a2a"],
        "properties": {
          "tool_authorizations": { "maxItems": 0 }
        }
      }
    }
  ]
}
