#cloud-config
# Cloud-init for Stage 02 Lite Single-VM Scion Hub (pinned release + pinned SHA-256 verification).
# Enforces gcp_iam_check_mode=enforce, default_gcp_identity_mode=block, and default_agent_role=baseline.
# Binds 0.0.0.0 on the VPC-private VM (zero public IP) with container_hub_endpoint=http://scion-hub.internal:8080
# so Docker agents run on bridge networking with isolated metadata interception (HC-01 F6/F7/F14/F19).

# Configure bounded APT HTTP/HTTPS timeouts before package_update to prevent mirror CLOSE-WAIT stalls (HC-02 F3).
bootcmd:
  - |
    mkdir -p /etc/apt/apt.conf.d
    cat > /etc/apt/apt.conf.d/99-scion-timeouts <<'APTCONF'
    Acquire::http::Timeout "30";
    Acquire::https::Timeout "30";
    Acquire::Retries "3";
    APTCONF

package_update: true

packages:
  - ca-certificates
  - curl
  - git
  - jq
  - sqlite3

write_files:
  - path: /etc/systemd/system/scion-hub.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Scion Hub (Lite Single-VM)
      After=network-online.target docker.service
      Requires=docker.service

      [Service]
      Type=simple
      User=scion
      Group=scion
      WorkingDirectory=/home/scion
      EnvironmentFile=/home/scion/.scion/hub.env
      ExecStart=/opt/scion/current/scion server start --foreground --hosted --enable-hub --enable-web --host 0.0.0.0 --web-port 8080 --enable-runtime-broker
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

runcmd:
  - mkdir -p /etc/apt/keyrings
  - |
    if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
    fi
  - |
    if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" > /etc/apt/sources.list.d/docker.list
    fi
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - systemctl enable --now docker
  - id scion >/dev/null 2>&1 || useradd -m -U -s /bin/bash scion
  - usermod -aG docker scion
  - |
    # Expose snap gcloud Docker credential helper on standard systemd PATH (HC-01 F6).
    if [ -x /snap/bin/docker-credential-gcloud ]; then
      ln -sfn /snap/bin/docker-credential-gcloud /usr/local/bin/docker-credential-gcloud
    fi
    if command -v gcloud >/dev/null 2>&1; then
      su - scion -c "gcloud auth configure-docker ${region}-docker.pkg.dev --quiet" || true
    fi
  - mkdir -p /opt/scion/releases/${scion_version} /home/scion/.scion/plugins/broker /home/scion/.scion/workspace-storage
  - |
    cd /tmp
    BASE_URL="https://github.com/GoogleCloudPlatform/scion/releases/download/${scion_version}"
    curl -fsSLO "$BASE_URL/scion-linux-amd64.tar.gz"
    echo "${scion_binary_sha256}  scion-linux-amd64.tar.gz" | sha256sum -c -
    tar -xzf scion-linux-amd64.tar.gz -C /opt/scion/releases/${scion_version}
    ln -sfn /opt/scion/releases/${scion_version} /opt/scion/current
    ln -sfn /opt/scion/current/scion /usr/local/bin/scion
    rm -f scion-linux-amd64.tar.gz
  - |
    if [ ! -f /home/scion/.scion/hub.env ]; then
      SECRET="$(head -c 32 /dev/urandom | base64 | tr -d '\n')"
      BASE_URL="${hub_public_url != "" ? hub_public_url : "https://${name_prefix}-hub-vm.internal:8080"}"
      printf "SCION_SERVER_SESSION_SECRET=%s\nSCION_GCP_PROJECT_ID=%s\nGOOGLE_CLOUD_PROJECT=%s\nSCION_SERVER_BASE_URL=%s\n" \
        "$SECRET" "${hub_project_id}" "${hub_project_id}" "$BASE_URL" > /home/scion/.scion/hub.env
      chmod 600 /home/scion/.scion/hub.env
    fi
  - |
    if [ ! -f /home/scion/.scion/settings.yaml ]; then
      cat > /home/scion/.scion/settings.yaml <<'EOF'
    schema_version: "1"
    image_registry: "${artifact_registry_url}"
    default_gcp_identity_mode: "block"
    default_agent_role: "baseline"
    telemetry:
      enabled: true
      cloud:
        enabled: true
        provider: "gcp"
        gcp_project_id: "${hub_project_id}"
    server:
      hub:
        gcp_project_id: "${hub_project_id}"
        gcp_iam_check_mode: "enforce"
        gcp_iam_deny_unknown_policy: "${gcp_iam_deny_unknown_policy}"
%{ if hub_public_url != "" ~}
        public_url: "${hub_public_url}"
%{ endif ~}
%{ if length(admin_emails) > 0 ~}
        admin_emails:
%{ for email in admin_emails ~}
          - "${email}"
%{ endfor ~}
%{ endif ~}
      broker:
        container_hub_endpoint: "http://scion-hub.internal:8080"
%{ if length(oidc_allowed_domains) > 0 || length(oidc_allowed_gcp_projects) > 0 ~}
      federation:
        enabled: true
        trusted_issuers:
          - issuer_url: "https://accounts.google.com"
            jwks_url: "https://www.googleapis.com/oauth2/v3/certs"
            issuer_type: "user"
            expected_audience: "32555940559.apps.googleusercontent.com"
%{ if length(oidc_allowed_domains) > 0 ~}
            allowed_domains:
%{ for dom in oidc_allowed_domains ~}
              - "${dom}"
%{ endfor ~}
%{ endif ~}
%{ if length(oidc_allowed_gcp_projects) > 0 ~}
            allowed_gcp_projects:
%{ for proj in oidc_allowed_gcp_projects ~}
              - "${proj}"
%{ endfor ~}
%{ endif ~}
%{ endif ~}
    EOF
    fi
  - chown -R scion:scion /home/scion/.scion
  - systemctl daemon-reload
  - systemctl enable --now scion-hub.service

final_message: "Scion Lite Single-VM Hub bootstrap complete"
